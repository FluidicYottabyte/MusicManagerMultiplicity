#extend("base"):
#export("content"):
<h1>Library</h1>
<form action="/library" method="get" style="margin-bottom:12px;">
    <input type="search" name="q" placeholder="Search title, artist, album..." value="#(query)" style="width:60%">
    <button type="submit" class="win-button small">Search</button>
</form>

#if(isEmpty):
<p>No songs found. <a href="/upload">Upload one</a> to get started!</p>
#else:
<div class="win-sunken song-list" data-queue>
<table class="rows" id="song-table">
    <tbody>
    #for(song in songs):
    <tr class="song-row" data-id="#(song.id)">
        <td><img class="thumb" src="#(song.coverURL)" alt=""></td>
        <td>#(song.title)</td>
        <td>#(song.artistNames)</td>
        <td>#(song.albumName)</td>
    </tr>
    #endfor
    </tbody>
</table>
<script type="application/json">#(songsJSON)</script>
</div>
#endif
#endexport
#endextend
