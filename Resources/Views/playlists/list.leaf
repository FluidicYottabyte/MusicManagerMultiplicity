#extend("base"):
#export("content"):
<h1>Playlists</h1>
<a href="/playlists/new" class="win-button">+ New Playlist</a>

#if(isEmpty):
<p>No playlists yet.</p>
#else:
<div class="card-grid" style="margin-top:14px;">
    #for(playlist in playlists):
    <a class="card win-raised" href="/playlists/#(playlist.id)">
        <img src="#(playlist.coverURL)" alt="">
        <div class="name">#(playlist.name)</div>
        <div style="font-size:11px;">by #(playlist.ownerUsername) — #(playlist.songCount) song(s)</div>
    </a>
    #endfor
</div>
#endif
#endexport
#endextend
