# Copy to .env and fill in real values before running locally or in production.

# SQLite file used by Prisma. Path is relative to the project root at runtime.
DATABASE_URL="file:./storage/db.sqlite"

# Root directory for uploaded/transcoded audio, cover art, and playlist covers.
# Relative paths are resolved against the project root.
STORAGE_ROOT="./storage"

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://127.0.0.1:3000"
